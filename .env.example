# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Sender Email Address
# Default testing domain provided by Resend: onboarding@resend.dev
# Or your verified domain: Sophia <contact@yourdomain.com>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Receiver Email Address (Your email where inquiries will be sent)
CONTACT_RECEIVER_EMAIL=your-email@example.com
